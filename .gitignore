*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.xcuserstate
xcuserdata/
*.moved-aside
*.hmap
*.ipa
*.pdf

# Swift Package Manager
.build/
Packages/
Package.resolved
.swiftpm/

# CocoaPods
Pods/

# ML model files (large binaries — download at runtime, do not commit)
**/Resources/models/

# Secrets / Config (never commit secrets)
**/Secrets.plist
**/Secrets.xcconfig
**/secrets.plist

# Claude Code worktrees
.claude/worktrees/
.worktrees/

# Scratch / test files
test.txt

# macOS
.DS_Store
*.swp
*.swo
*~

# Environment
.env
.env.local

# Local VoiceIDE alias folder (keep only README guidance)
ios/VoiceIDE/**
!ios/VoiceIDE/README.md

# Node / TypeScript
node_modules/
**/node_modules/

# TypeScript/Node build output
dist/
**/dist/
*.tsbuildinfo

# Backend (TypeScript compiled output)
backend/dist/

# Server build
server/dist/

# Test/coverage output
coverage/
**/coverage/
.nyc_output/

# Turborepo / monorepo caches
.turbo/
.turbo

# Next.js (if ever used)
.next/
out/

# Node/npm
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
